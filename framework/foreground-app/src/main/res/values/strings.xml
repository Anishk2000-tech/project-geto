<resources>
    <string name="foreground_app_service_label">Geto app switching</string>
    <string name="foreground_app_service_summary">Lets Geto apply a profile only while its app is open</string>
    <string name="foreground_app_service_description">Geto needs to know which app you are using so it can apply that app\'s settings when you open it and put your original settings back when you leave. It only reads the name of the app in front — it does not read screen content, text or passwords.</string>
</resources>
